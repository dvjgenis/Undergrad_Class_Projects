# ── Theory Inspector / AI Infrastructure ─────────────────────────────
# Copy to .env and add keys when ready. Without keys, Theory Inspector
# runs deterministically (RAG + symbolic tools only).

# API keys (optional; enable LLM enrichment when TI_USE_LLM_TUTOR=true)
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Enable LLM tutor enrichment (default: false). Requires at least one API key.
# When false, explanations use RAG + templates only (no API calls).
TI_USE_LLM_TUTOR=false

# Model overrides (used when LLM enrichment is enabled)
TI_LEADER_MODEL=llama-3.1-8b-instant
TI_AUDITOR_MODEL=gpt-4o-mini
TI_TUTOR_MODEL=claude-3-5-sonnet-latest

# ChromaDB vector index path (default: TheoryInspector/index/chroma_db)
TI_CHROMA_DIR=TheoryInspector/index/chroma_db

